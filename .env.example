APP_NAME="Finns Kerrisdale Ladies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# New site database (MySQL 8 / MariaDB 10.6+). For a quick local trial you can use DB_CONNECTION=sqlite instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finns_kerrisdale
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@finnskerrisdaleladies.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------
# Finns Kerrisdale Ladies
# ------------------------------------------------------------------
# React apps allowed to call the API (CORS). Exact origins, never "*".
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Optional extra origins, comma separated (e.g. https://www.finnskerrisdaleladies.com)
CORS_EXTRA_ORIGINS=
# Built website (npm run build in /frontend). Laravel serves its index.html with per-URL SEO tags.
FRONTEND_DIST_PATH=../frontend/dist

# Admin login lifetime in minutes (default 7 days)
SANCTUM_EXPIRATION=10080

# First admin account created by `php artisan db:seed`. Leave ADMIN_PASSWORD empty to have one generated and printed.
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@finnskerrisdaleladies.com
ADMIN_PASSWORD=

# Image processing for every upload
IMAGE_DRIVER=gd
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
IMAGE_QUALITY=82
IMAGE_FORMAT=webp
IMAGE_MAX_UPLOAD_KB=15360
MEDIA_DISK=public

# Old WordPress database — only needed while running `php artisan wp:import`
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=finns_wordpress
WP_DB_USERNAME=root
WP_DB_PASSWORD=
